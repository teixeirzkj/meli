# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key

# Só o servidor lê esta (sem NEXT_PUBLIC_): ignora RLS e é usada apenas pelas
# server actions do painel admin, para criar e excluir contas no Auth.
# Nunca exponha no navegador nem comite o valor.
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key
